# Copy to .env for Docker Compose or local development and replace example values.
MYSQL_DATABASE=english-app
MYSQL_USER=root
MYSQL_PASSWORD=change-this-local-database-password

DB_URL=jdbc:mysql://localhost:3306/english-app
DB_USERNAME=root
DB_PASSWORD=change-this-local-database-password

# Generate a fresh Base64 key, for example: openssl rand -base64 32
JWT_SECRET_KEY=replace-with-a-new-base64-signing-key

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM=your-email@example.com

# Optional; database backups are disabled unless explicitly enabled.
BACKUP_ENABLED=false
BACKUP_DB_NAME=english-app
BACKUP_DB_HOST=localhost
BACKUP_DB_PORT=3306
BACKUP_DB_USERNAME=root
BACKUP_DB_PASSWORD=change-this-local-database-password
YANDEX_DISK_TOKEN=replace-with-a-new-yandex-disk-token
